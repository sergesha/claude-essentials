{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    "continuous-learning": {
      "package-name": "continuous-learning",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    },
    "redis-memory-mcp": {
      "package-name": "redis-memory-mcp",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.5.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "server/pyproject.toml", "jsonpath": "$.project.version" }
      ]
    },
    "lockstep": {
      "package-name": "lockstep",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "toml", "path": "engine/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "engine/src/lockstep/__init__.py" }
      ]
    },
    "speciflow": {
      "package-name": "speciflow",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    },
    "code-intel": {
      "package-name": "code-intel",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
