{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "tech-radar",
  "displayName": "Tech Radar",
  "description": "AI-powered technology scout: monitors news via SearXNG, stores summaries with semantic search in Redis, generates HTML dashboards.",
  "version": "0.7.0",
  "author": {
    "name": "sergesha"
  },
  "homepage": "https://github.com/sergesha/claude-essentials/tree/main/tech-radar",
  "license": "MIT",
  "keywords": [
    "news",
    "tech-radar",
    "searxng",
    "monitoring",
    "dashboard"
  ],
  "hooks": "./hooks/session-start.json",
  "mcpServers": {
    "searxng-mcp": {
      "command": "sh",
      "args": [
        "-c",
        "export SEARXNG_URL=\"${SEARXNG_URL:-http://localhost:8888}\" CACHE_URL=\"${CACHE_URL:-redis://localhost:6381}\"; exec npx -y @tadmstr/searxng-mcp"
      ]
    }
  }
}
