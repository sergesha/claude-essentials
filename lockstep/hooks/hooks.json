{
  "description": "lockstep hook wrappers (Stop / SessionStart / PreToolUse / PostToolUse) — run the plugin's own cloned engine via uv, no PyPI dependency.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__lockstep__.*|mcp__plugin_.+_lockstep__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-posttool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
