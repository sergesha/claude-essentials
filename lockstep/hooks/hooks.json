{
  "description": "lockstep hook wrappers (Stop / SessionStart / PreToolUse / PostToolUse) \u2014 run the plugin's own cloned engine via uv, no PyPI dependency. Timeouts are generous ON PURPOSE: a hook killed at its budget emits no output, and a timed-out PreToolUse hook is treated as non-blocking \u2014 the gate would fail OPEN. The first fire in a cold environment resolves and builds the engine's dependencies; run `lockstep-mcp doctor` once after install to pay that cost outside the gate.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-pretool",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__lockstep__.*|mcp__plugin_.+_lockstep__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/engine lockstep-mcp hook-posttool",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
