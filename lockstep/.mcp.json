{
  "mcpServers": {
    "lockstep": {
      "command": "./scripts/lockstep-plugin",
      "args": [
        "serve"
      ],
      "env": {
        "LOCKSTEP_PLUGIN_HOST": "codex"
      },
      "env_vars": [
        "LOCKSTEP_STATE_DIR"
      ],
      "cwd": "./",
      "required": true,
      "default_tools_approval_mode": "approve",
      "startup_timeout_sec": 300,
      "tool_timeout_sec": 900
    }
  }
}
