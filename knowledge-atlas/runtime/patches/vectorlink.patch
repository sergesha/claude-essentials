+#[tokio::test]
+async fn generic_prime_cache_roundtrip_preserves_roles_without_provider(){
+ use arrow_array::{RecordBatch,RecordBatchIterator,StringArray,Float32Array,FixedSizeListArray};
+ use arrow_schema::{Schema,Field,DataType};
+ use vectorlink::store::lance::encode_domain_path;
+ let temp=tempfile::tempdir().unwrap();let domain="admin/poc9";
+ let field=Arc::new(Field::new("item",DataType::Float32,true));
+ let schema=Arc::new(Schema::new(vec![Field::new("content",DataType::Utf8,false),Field::new("embedding",DataType::FixedSizeList(field.clone(),2),false),Field::new("clustering_embedding",DataType::FixedSizeList(field.clone(),2),false)]));
+ let doc=FixedSizeListArray::new(field.clone(),2,Arc::new(Float32Array::from(vec![1.0f32,0.0])),None);
+ let cluster=FixedSizeListArray::new(field,2,Arc::new(Float32Array::from(vec![0.0f32,1.0])),None);
+ let batch=RecordBatch::try_new(schema.clone(),vec![Arc::new(StringArray::from(vec!["same input"])),Arc::new(doc),Arc::new(cluster)]).unwrap();
+ let uri=temp.path().join(format!("{}.lance",encode_domain_path(domain)));
+ lance::Dataset::write(RecordBatchIterator::new(vec![Ok(batch)],schema),uri.to_str().unwrap(),None).await.unwrap();
+ let out=std::process::Command::new(env!("CARGO_BIN_EXE_vectorlink"))
+  .args(["prime-embed-cache","--from-domain",domain,"--include-clustering"])
+  .env("VECTORLINK_DATA_DIR",temp.path()).env("VECTORLINK_EMBED_PROVIDER","generic_http")
+  .env("VECTORLINK_MODEL","poc9-gemma-q4-profile-a").env("VECTORLINK_DIM","2")
+  .env("VECTORLINK_EMBED_URL","http://127.0.0.1:9").output().unwrap();
+ assert!(out.status.success(),"{}",String::from_utf8_lossy(&out.stderr));
+ let cache=EmbedCache::open(&temp.path().join("embed_cache"),Some(100));
+ let provider=Provider::GenericHttp{base_url:"http://127.0.0.1:9".into(),model:"poc9-gemma-q4-profile-a".into(),dim:2};
+ let client=reqwest::Client::new();let texts=vec!["same input".into()];
+ assert_eq!(io_embed(&provider,&texts,EmbeddingRole::Document,&client,Some(&cache)).await.unwrap(),vec![vec![1.0,0.0]]);
+ assert_eq!(io_embed(&provider,&texts,EmbeddingRole::Clustering,&client,Some(&cache)).await.unwrap(),vec![vec![0.0,1.0]]);
+ assert!(io_embed(&provider,&texts,EmbeddingRole::Query,&client,Some(&cache)).await.is_err());
+}
