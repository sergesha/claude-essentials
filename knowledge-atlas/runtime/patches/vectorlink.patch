+#[tokio::test]
+async fn poc9_eligible_topk_survives_excluded_neighbours() {
+    let mut outcomes = Vec::new();
+    for mode in [SearchMode::Vector, SearchMode::Fts, SearchMode::Hybrid] {
+        let label = format!("{:?}", mode);
+        let mut ids_by_corpus = Vec::new();
+        for with_distractors in [false, true] {
+            let (store, _tmp) = make_test_store(8);
+            let domain = "admin/poc9_prefilter";
+            let mut rows = Vec::new();
+            for i in 0..if with_distractors {13} else {1} {
+                let eligible = i == 0;
+                let embedding = if eligible {vec![0.,1.,0.,0.,0.,0.,0.,0.]} else {vec![1.,0.,0.,0.,0.,0.,0.,0.]};
+                rows.push(ChunkRow {
+                    doc_id: if eligible {"allowed".into()} else {format!("excluded-{}",i)},
+                    doc_type: "Observation".into(), chunk_index:0, chunk_count:1,
+                    chunk_token_start:0, doc_token_len:20,
+                    embedding:embedding.clone(), clustering_embedding:embedding,
+                    content: if eligible {"sensor calibration context uncertainty observation conditions outcome review".into()} else {"sensor sensor sensor".into()},
+                });
+            }
+            store.io_upsert_chunks(domain,"main","fixture",&rows).await.unwrap();
+            let version=store.io_ensure_fts_index(domain,"main").await.unwrap();
+            store.io_tag_commit(domain,"main","c0",version).await.unwrap();
+            store.io_refresh_cached_dataset(domain,"main").await.unwrap();
+            let q=SearchQuery {
+                query_embedding:vec![1.,0.,0.,0.,0.,0.,0.,0.],
+                query_text:"sensor".into(),mode:mode.clone(),start:0,count:1,
+                doc_type_filter:vec![],doc_id_filter:vec!["allowed".into()],snippet:false,
+            };
+            let hits=store.io_search(domain,"main","c0",&q).await.unwrap();
+            ids_by_corpus.push(hits.iter().map(|h|h.doc_id.clone()).collect::<Vec<_>>());
+        }
+        println!("POC9 {} control={:?} distractors={:?}",label,ids_by_corpus[0],ids_by_corpus[1]);
+        outcomes.push((label,ids_by_corpus));
+    }
+    for (mode,ids) in outcomes {
+        assert_eq!(ids[0],vec!["allowed".to_string()],"{} eligible-only control",mode);
+        assert_eq!(ids[1],vec!["allowed".to_string()],"{} filter must precede top-K",mode);
+    }
+}
