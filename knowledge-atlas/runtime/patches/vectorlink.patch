+/// Shared by provider lookups and offline cache priming. Input is already
+/// prefixed by apply_prefix; GenericHttp retains explicit role identity.
+pub fn embedding_cache_key(provider: &Provider, prefixed_text: &str, role: EmbeddingRole) -> [u8; 32] {
+    let model = provider.model_name();
+    let cache_model = if matches!(provider, Provider::GenericHttp { .. }) {
+        serde_json::to_string(&("vectorlink-generic-role-v1", model, provider.expected_dim(), role))
+            .expect("serializing embedding cache identity")
+    } else {
+        model.to_owned()
+    };
+    EmbedCache::cache_key(&cache_model, prefixed_text)
+}
