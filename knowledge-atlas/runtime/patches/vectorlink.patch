+++ b/tests/poc9_embedding_role.rs
@@ -0,0 +1,69 @@
+use std::sync::{Arc,Mutex};
+use axum::{Router,routing::post,extract::State,Json};
+use serde_json::{json,Value};
+use vectorlink::embed::{io_embed,Provider,EmbeddingRole,cache::EmbedCache};
+async fn fixture() -> (String,Arc<Mutex<Vec<Value>>>,tokio::task::JoinHandle<()>) {
+ let seen=Arc::new(Mutex::new(Vec::<Value>::new()));
+ async fn handler(State(seen):State<Arc<Mutex<Vec<Value>>>>,Json(body):Json<Value>)->Json<Value>{
+  let mut calls=seen.lock().unwrap();calls.push(body.clone());
+  let n=calls.len() as f32;
+  Json(json!({"data":body["input"].as_array().unwrap().iter().enumerate().map(|(i,_)|json!({"index":i,"embedding":[n,0.0]})).collect::<Vec<_>>()}))
+ }
+ let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+ let url=format!("http://{}",listener.local_addr().unwrap());
+ let app=Router::new().route("/v1/embeddings",post(handler)).with_state(seen.clone());
+ let handle=tokio::spawn(async move {axum::serve(listener,app).await.unwrap()});
+ (url,seen,handle)
+}
+#[tokio::test]
+async fn generic_provider_receives_role_without_mutating_raw_input(){
+ let (url,seen,h)=fixture().await;let p=Provider::GenericHttp{base_url:url,model:"poc9-gemma-q4-profile-a".into(),dim:2};
+ let client=reqwest::Client::new();let text=vec!["Conditions are unknown.".into()];
+ for role in [EmbeddingRole::Document,EmbeddingRole::Query] {io_embed(&p,&text,role,&client,None).await.unwrap();}
+ let calls=seen.lock().unwrap();assert_eq!(calls[0]["role"],"document");assert_eq!(calls[1]["role"],"query");
+ assert_eq!(calls[0]["input"],json!(["Conditions are unknown."]));assert_eq!(calls[1]["input"],calls[0]["input"]);h.abort();
+}
+#[tokio::test]
+async fn generic_cache_never_reuses_document_vector_as_query(){
+ let (url,seen,h)=fixture().await;let p=Provider::GenericHttp{base_url:url,model:"poc9-gemma-q4-profile-a".into(),dim:2};
+ let temp=tempfile::tempdir().unwrap();let cache=EmbedCache::open(temp.path(),Some(100));let client=reqwest::Client::new();let text=vec!["same input".into()];
+ let doc=io_embed(&p,&text,EmbeddingRole::Document,&client,Some(&cache)).await.unwrap();
+ let query=io_embed(&p,&text,EmbeddingRole::Query,&client,Some(&cache)).await.unwrap();
+ assert_ne!(doc,query,"query must reach provider despite existing document cache");
+ assert_eq!(io_embed(&p,&text,EmbeddingRole::Query,&client,Some(&cache)).await.unwrap(),query);
+ assert_eq!(io_embed(&p,&text,EmbeddingRole::Document,&client,Some(&cache)).await.unwrap(),doc);
+ assert_eq!(seen.lock().unwrap().len(),2);h.abort();
+}
+#[tokio::test]
+async fn openai_compatible_keeps_existing_request_shape(){
+ let (url,seen,h)=fixture().await;let p=Provider::OpenAiCompatible{base_url:url,model:"test-model".into(),dim:2};
+ io_embed(&p,&["raw".into()],EmbeddingRole::Query,&reqwest::Client::new(),None).await.unwrap();
+ assert!(seen.lock().unwrap()[0].get("role").is_none());h.abort();
+}
