+    maplist(embedded_unify_option(Resp.headers), Options).
+
+embedded_unify_option(Headers, header(Name, Value)) :-
+    !,
+    embedded_header_value(Headers, Name, Value).
+embedded_unify_option(_, _).
 
 %% embedded_header_value(+Headers, +Name, ?Value) is semidet.
 %
@@ -942,9 +946,30 @@ io_search_forward(Endpoint, Domain, Search_Ref, Ancestors,
                   Extra_Params, Response_Body, Data_Version_Header) :-
     assert_search_backend,
     search_auth_header(AuthHeader),
-    build_search_url(Endpoint, Domain, Search_Ref, Ancestors, Base_URL),
-    append_extra_params(Base_URL, Extra_Params, URL),
-    io_forward_get(URL, AuthHeader, Response_Body, Data_Version_Header).
+    build_search_url(Endpoint, Domain, Search_Ref, [], Base_URL),
+    search_forward_payload(Extra_Params, Ancestors, Query_Params, Post_Body),
+    append_extra_params(Base_URL, Query_Params, URL),
+    io_forward_post(URL, AuthHeader, Post_Body, Response_Body, Data_Version_Header).
+
+% VectorLink POST reads arrays, ancestors and snippet only from its JSON body.
+% Keep scalar query parsing unchanged; never encode a full snapshot's IDs in URI.
+search_forward_payload(Params, Ancestors, Query_Params, Body) :-
+    partition(search_body_param, Params, Body_Params, Query_Params),
+    maplist(search_body_pair, Body_Params, Pairs),
+    dict_create(Body, json, [ancestors-Ancestors|Pairs]).
+
+search_body_param(doc_id=repeated(_)).
+search_body_param(doc_type=repeated(_)).
+search_body_param(snippet=_).
+
+search_body_pair(Key=repeated(Values), Key-Values) :- !.
+search_body_pair(snippet=Value, snippet-Boolean) :-
+    (   memberchk(Value, [true, "true"])
+    ->  Boolean = true
+    ;   memberchk(Value, [false, "false"])
+    ->  Boolean = false
+    ;   Boolean = Value
+    ).
 
