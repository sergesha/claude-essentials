@@ -4310,6 +4343,20 @@ test("post_delete_db_hook is silent no-op when vectorlink endpoint is not set",
 
 :- begin_tests(vectorlink_fronting_params).
 
+test("POST search preserves filters ancestors and snippet outside URI") :-
+    vectorlink:search_forward_payload(
+        [q="Mist-A",count=682,doc_id=repeated(["a","b"]),
+         doc_type=repeated(["Chunk"]),snippet="true"], ["previous"], Query, Body),
+    assertion(Query == [q="Mist-A",count=682]),
+    assertion(Body == json{doc_id:["a","b"],doc_type:["Chunk"],
+                           snippet:true,ancestors:["previous"]}).
+
+test("POST exact search retains empty ancestors and false snippet") :-
+    vectorlink:search_forward_payload([q='test',snippet=false], [], Query, Body),
+    assertion(Query == [q='test']),
+    assertion(Body == json{snippet:false,ancestors:[]}).
