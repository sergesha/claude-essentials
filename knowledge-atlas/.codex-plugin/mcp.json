{
  "mcpServers": {
    "knowledge-atlas": {
      "command": "sh",
      "args": [
        "scripts/launch.sh",
        "mcp"
      ],
      "env_vars": [
        "KNOWLEDGE_ATLAS_CONFIG",
        "KNOWLEDGE_ATLAS_PYTHON",
        "KNOWLEDGE_ATLAS_GRAPH_KEY_FILE",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "KNOWLEDGE_ATLAS_DOCKER_PROJECT",
        "DOCKER_CONTEXT",
        "DOCKER_HOST"
      ],
      "startup_timeout_sec": 300,
      "cwd": "."
    }
  }
}
