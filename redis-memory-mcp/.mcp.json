{
  "mcpServers": {
    "redis-memory-mcp": {
      "command": "bash",
      "args": [
        "-c",
        "t=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/sergesha/claude-essentials/main/redis-memory-mcp/start.sh -o $t && exec bash $t"
      ],
      "env": {
        "REDIS_MEMORY_MCP_MODE": "${user_config.mode}",
        "REDIS_URL": "${user_config.redis_url}",
        "EMBED_URL": "${user_config.embed_url}",
        "NAMESPACE": "${user_config.namespace}",
        "REDIS_MEMORY_MCP_NETWORK": "${user_config.network}",
        "EMBED_SOCKET": "${user_config.embed_socket}",
        "REDIS_MEMORY_MCP_SOCKET_DIR": "${user_config.socket_dir}",
        "CHUNK_MAX_TOKENS": "${user_config.chunk_max_tokens}",
        "EMBED_DIMENSION": "${user_config.embed_dimension}"
      },
      "_description": "Self-installing Redis + shared Gemma Q4 embeddings + MCP server",
      "_required": true,
      "_setup": "Only dependency: Docker."
    }
  }
}
